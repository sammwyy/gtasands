#---------------------------------------------------------------------------------
# GTA:SA DS port - ARM9 build (devkitARM + libnds/calico)
#---------------------------------------------------------------------------------
.SUFFIXES:

ifneq ($(strip $(DEVKITARM)),)
DEVKITPRO ?= $(abspath $(DEVKITARM)/..)
else
ifeq ($(strip $(DEVKITPRO)),)
$(error "Set DEVKITPRO or DEVKITARM in your environment")
endif
endif
DEVKITARM ?= $(DEVKITPRO)/devkitARM

GAME_TITLE     := GTA: San Andreas DS
GAME_SUBTITLE1 := Port by Sammwy

include $(DEVKITARM)/ds_rules

export CC := $(DEVKITARM)/bin/arm-none-eabi-gcc
export CXX := $(DEVKITARM)/bin/arm-none-eabi-g++

# two-line banner (ds_rules always adds a third line, defaulting to devkitpro.org);
# the icon is icon.bmp (32x32, 16 colours), picked up automatically below
%.nds: %.elf
	$(SILENTCMD)ndstool -c $@ -9 $< $(_ARM7_ELF) -b $(GAME_ICON) "$(GAME_TITLE);$(GAME_SUBTITLE1)" $(_ADDFILES)
	$(SILENTMSG) built ... $(notdir $@)

rwildcard = $(foreach d,$(wildcard $(1:=/*)),$(call rwildcard,$d,$2) $(filter $(subst *,%,$2),$d))

#---------------------------------------------------------------------------------
# TARGET   output name
# BUILD    object/intermediate dir
# SOURCES  every directory under src/ (recursive)
# NITRO    NitroFS root, generated by `make assets` from game/
#---------------------------------------------------------------------------------
MODE     ?= ds
STORAGE  ?= rom
ifneq ($(origin FAT),undefined)
$(error FAT= is obsolete; use STORAGE=sd for SD assets, or STORAGE=rom for embedded assets)
endif
TARGET   := gtasads
BUILD    := build/tmp/$(MODE)-$(STORAGE)
ROM      := $(if $(filter rom,$(STORAGE)),fat-,)gtasads.$(if $(filter dsi,$(MODE)),dsi,nds)
SOURCES  := $(patsubst %/,%,$(sort $(dir $(call rwildcard,src,*.c *.cpp *.s))))
INCLUDES := src
DATA     := data
GRAPHICS :=
AUDIO    :=
ICON     :=
NITRO    := nitrofs

EMU      ?= melonds
DEBUG    ?= 0
DLDI     ?= $(CURDIR)/tools/dldi/r4tfv2.dldi

#---------------------------------------------------------------------------------
# code generation
#---------------------------------------------------------------------------------
ARCH := -march=armv5te -mtune=arm946e-s

ifeq ($(DEBUG),1)
OPT := -Og -DGTASADS_DEBUG
else
OPT := -O2
endif

ifeq ($(STORAGE),sd)
OPT += -DGTASADS_FAT
endif

ifeq ($(MODE),dsi)
OPT += -DGTASADS_DSI
endif

# QUICKTEST=1: skip intro movies, auto-start the game, force the GAME hud
# screen (headless smoke path).
QUICKTEST ?= 0
ifeq ($(QUICKTEST),1)
OPT += -DGTASADS_QUICKTEST
endif

CFLAGS   := -g -Wall -Wextra $(OPT) -ffunction-sections -fdata-sections \
            $(ARCH) $(INCLUDE) -DARM9
CXXFLAGS := $(CFLAGS) -std=gnu++17 -fno-rtti -fno-exceptions
ASFLAGS  := -g $(ARCH)
LDFLAGS   = -specs=ds_arm9.specs -g $(ARCH) -Wl,--gc-sections -Wl,-Map,$(notdir $*.map)

LIBS := -lnds9
ifneq ($(strip $(NITRO)),)
ifeq ($(STORAGE),rom)
LIBS := -lfilesystem $(LIBS)
endif
endif
LIBS := -lfat $(LIBS)
ifneq ($(strip $(AUDIO)),)
LIBS := -lmm9 $(LIBS)
endif

LIBDIRS := $(LIBNDS) $(PORTLIBS)

#---------------------------------------------------------------------------------
ifneq ($(INTERNAL),1)
#---------------------------------------------------------------------------------

export DLDI := $(DLDI)
export OUTPUT := $(CURDIR)/$(BUILD)/$(TARGET)
export ROM_OUTPUT := $(CURDIR)/build/$(ROM)

export VPATH := $(CURDIR)/$(subst /,,$(dir $(ICON)))\
                $(foreach dir,$(SOURCES),$(CURDIR)/$(dir))\
                $(foreach dir,$(DATA),$(CURDIR)/$(dir))\
                $(foreach dir,$(GRAPHICS),$(CURDIR)/$(dir))

export DEPSDIR := $(CURDIR)/$(BUILD)

CFILES   := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
CPPFILES := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
SFILES   := $(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.s)))
PNGFILES := $(foreach dir,$(GRAPHICS),$(notdir $(wildcard $(dir)/*.png)))
BINFILES := $(foreach dir,$(DATA),$(notdir $(wildcard $(dir)/*.*)))

DUPES := $(sort $(foreach f,$(CFILES) $(CPPFILES) $(SFILES),$(if $(filter-out 1,$(words $(filter $f,$(CFILES) $(CPPFILES) $(SFILES)))),$f)))
ifneq ($(strip $(DUPES)),)
$(error Duplicate source basenames (objects are flattened into build/): $(DUPES))
endif

ifneq ($(strip $(NITRO)),)
ifeq ($(STORAGE),rom)
  export NITRO_FILES := $(CURDIR)/$(NITRO)
else
  NITRO_FILES :=
  unexport NITRO_FILES
endif
endif

ifneq ($(strip $(AUDIO)),)
  export MODFILES := $(foreach dir,$(notdir $(wildcard $(AUDIO)/*.*)),$(CURDIR)/$(AUDIO)/$(dir))
  ifneq ($(strip $(NITRO)),)
    export SOUNDBANK := $(NITRO_FILES)/soundbank.bin
  else
    export SOUNDBANK := soundbank.bin
    BINFILES += $(SOUNDBANK)
  endif
endif

ifeq ($(strip $(CPPFILES)),)
  export LD := $(CC)
else
  export LD := $(CXX)
endif

export OFILES_BIN     := $(addsuffix .o,$(BINFILES))
export OFILES_SOURCES := $(CPPFILES:.cpp=.o) $(CFILES:.c=.o) $(SFILES:.s=.o)
export OFILES         := $(PNGFILES:.png=.o) $(OFILES_BIN) $(OFILES_SOURCES)
export HFILES         := $(PNGFILES:.png=.h) $(addsuffix .h,$(subst .,_,$(BINFILES)))

export INCLUDE  := $(foreach dir,$(INCLUDES),-I$(CURDIR)/$(dir))\
                   $(foreach dir,$(LIBDIRS),-isystem $(dir)/include)\
                   -I$(CURDIR)/$(BUILD)
export LIBPATHS := $(foreach dir,$(LIBDIRS),-L$(dir)/lib)

ifeq ($(strip $(ICON)),)
  icons := $(wildcard *.bmp)
  ifneq (,$(findstring $(TARGET).bmp,$(icons)))
    export GAME_ICON := $(CURDIR)/$(TARGET).bmp
  else
    ifneq (,$(findstring icon.bmp,$(icons)))
      export GAME_ICON := $(CURDIR)/icon.bmp
    endif
  endif
else
  ifeq ($(suffix $(ICON)), .grf)
    export GAME_ICON := $(CURDIR)/$(ICON)
  else
    export GAME_ICON := $(CURDIR)/$(BUILD)/$(notdir $(basename $(ICON))).grf
  endif
endif

.PHONY: all build single build-ds build-dsi build-sd-ds build-sd-dsi stage-sd clean run run-ds run-sd run-sd-ds build-quick sdcard dldi sd assets sync distclean compdb

.DEFAULT_GOAL := all
.NOTPARALLEL: build
all: build
build: build-ds build-dsi build-sd-ds build-sd-dsi stage-sd

build-ds:
	@$(MAKE) --no-print-directory MODE=ds STORAGE=rom single
build-dsi:
	@$(MAKE) --no-print-directory MODE=dsi STORAGE=rom single
build-sd-ds:
	@$(MAKE) --no-print-directory MODE=ds STORAGE=sd single
build-sd-dsi:
	@$(MAKE) --no-print-directory MODE=dsi STORAGE=sd single

ASSET_DEPS := resources.toml $(filter-out tools/run.py,$(wildcard tools/*.py tools/gtasa/*.py))

single: $(NITRO)/.stamp
	@mkdir -p $(BUILD)
	@f=$(BUILD)/.optsig; sig="$(OPT)"; \
	if [ "`cat $$f 2>/dev/null`" != "$$sig" ]; then rm -f $(BUILD)/*.o; echo "$$sig" > $$f; fi
	@$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/Makefile INTERNAL=1

# ASSETS=0 skips the asset pipeline (packs whatever is already in nitrofs/)
ifeq ($(ASSETS),0)
$(NITRO)/.stamp:
	@mkdir -p $(NITRO) && touch $@
else
$(NITRO)/.stamp: $(ASSET_DEPS)
	@python3 tools/assets.py build
endif

assets:
	@python3 tools/assets.py build

sync:
	@python3 tools/assets.py sync

run: build-dsi
	@python3 tools/run.py dsi rom "$(EMU)"
run-ds: build-ds
	@python3 tools/run.py ds rom "$(EMU)"
run-sd: build-sd-dsi stage-sd
	@python3 tools/run.py dsi sd "$(EMU)"
run-sd-ds: build-sd-ds stage-sd
	@python3 tools/run.py ds sd "$(EMU)"

# quicktest smoke path: recompiles with -DGTASADS_QUICKTEST (skips intro
# movies, auto-starts the game); same build/ dir - the .optsig stamp below
# forces a rebuild when the flags change
build-quick:
	@$(MAKE) --no-print-directory QUICKTEST=1 build

stage-sd: $(NITRO)/.stamp
	@mkdir -p build/gtasads
	@cp -au $(NITRO)/. build/gtasads/

sdcard: build-sd-ds build-sd-dsi stage-sd

sd: sdcard
dldi: build-sd-ds build-sd-dsi

compdb:
	@$(MAKE) clean
	@generate_compile_commands $(MAKE) -j$$(nproc)

clean:
	@echo clean ...
	@rm -fr build/tmp build/gtasads build/*gtasads.nds build/*gtasads.dsi build/*gtasads.elf

distclean: clean
	@rm -fr $(NITRO)

#---------------------------------------------------------------------------------
else
#---------------------------------------------------------------------------------

# repack when any nitrofs file changes (dir mtime alone doesn't track contents);
# NITRO_FILES is the abs path exported from the top half (cwd is build/ here);
# unset under STORAGE=sd -> bare ROM without embedded fs
ifneq ($(strip $(NITRO_FILES)),)
NITRO_DEPS := $(call rwildcard,$(NITRO_FILES),*)
endif
$(ROM_OUTPUT): $(OUTPUT).elf $(NITRO_FILES) $(NITRO_DEPS) $(GAME_ICON)
	ndstool -c $@ -9 $< $(_ARM7_ELF) -b $(GAME_ICON) "$(GAME_TITLE);$(GAME_SUBTITLE1)" $(_ADDFILES)
ifeq ($(STORAGE),sd)
	$(DEVKITARM)/../tools/bin/dlditool $(DLDI) $@
endif
$(OUTPUT).elf: $(OFILES)

$(OFILES_SOURCES) : $(HFILES)
$(OFILES): $(SOUNDBANK)

$(SOUNDBANK) : $(MODFILES)
	mmutil $^ -d -o$@ -hsoundbank.h

%.bin.o %_bin.h : %.bin
	@echo $(notdir $<)
	@$(bin2o)

%.s %.h: %.png %.grit
	grit $< -fts -o$*

$(GAME_ICON): $(notdir $(ICON))
	@echo convert $(notdir $<)
	@grit $< -g -gt -gB4 -gT FF00FF -m! -p -pe 16 -fh! -ftr

-include $(DEPSDIR)/*.d

#---------------------------------------------------------------------------------
endif
#---------------------------------------------------------------------------------
